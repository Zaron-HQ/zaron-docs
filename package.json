{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "fumadocs-mdx && NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=7168' next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ingest-docs": "dotenv -e .env.local -- bun run scripts/ingest-docs.ts",
    "ingest-docs:force": "dotenv -e .env.local -- bun run scripts/ingest-docs.ts --force",
    "ingest-docs:dry": "bun run scripts/ingest-docs.ts --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tabler/icons-react": "^3.31.0",
    "@vercel/og": "^0.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.6.7",
    "fumadocs-mdx": "14.2.8",
    "fumadocs-openapi": "10.3.13",
    "fumadocs-ui": "16.6.7",
    "lucide-react": "^0.511.0",
    "minisearch": "7.2.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "4.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.12",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.0.4",
    "@aws-sdk/client-bedrock-runtime": "^3.787.0",
    "dotenv-cli": "^8.0.0",
    "postcss": "^8.5.3",
    "postgres": "^3.4.5",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2"
  }
}
